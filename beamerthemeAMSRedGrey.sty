%% The AMSUniBo Beamer style in the colours of the old AMSCesena, recovered.
%% Palette: beamercolorthemeredgrey.sty. Everything else, reasoning included: README.md.
%% name
\newcommand{\stylename}{AMSRedGrey Beamer style}
%% version -- Major.Minor[.Patch]; the release time-stamp is appended by the CI
\newcommand{\stylemajor}{1}
\newcommand{\styleminor}{2}
%% \stylepatch is optional: comment the next line out to release as Major.Minor
%\newcommand{\stylepatch}{0}
\ifdefined\stylepatch
  \newcommand{\styleversion}{\stylemajor.\styleminor.\stylepatch}
\else
  \newcommand{\styleversion}{\stylemajor.\styleminor}
\fi
\typeout{}
\typeout{\stylename-\styleversion}
%% the style that built this PDF, recorded in the Info dictionary and nowhere
%% else: no frame shows it, and it survives the file leaving the repository.
%% Written with the engine primitive, which merges: hyperref's own pdfinfo key
%% is claimed by beamer already and refuses a second use.
\ifdefined\pdfextension
  \pdfextension info{ /Style (\stylename\space\styleversion) }
\else
  \ifdefined\pdfinfo
    \pdfinfo{ /Style (\stylename\space\styleversion) }
  \fi
\fi
%% options
\newif\if@doApice
\@doApicefalse
\DeclareOption{apice}{\@doApicetrue}
%% which seal watermarks the slides -- none unless asked for: bologna (the Ateneo)
%% or cesena (the Campus). The seals belong to the Alma Mater, so a deck claims
%% one explicitly; whoever is outside the Alma Mater just leaves the option out
\newif\if@doSeal
\@doSealfalse
\newif\if@doCesena
\@doCesenafalse
\DeclareOption{bologna}{\@doSealtrue\@doCesenafalse}
\DeclareOption{cesena}{\@doSealtrue\@doCesenatrue}
\ProcessOptions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\mode<presentation>
%
%% the APICe marker, a publication's or (since 1.2) a talk's or a thesis's; expands to nothing
%% without the apice option. It carries its
%% own trailing gap, outside the link so the hotspot stops at the word: the .bst
%% appends two spaces after \apicepubpar, but BibTeX wraps the .bbl line there and
%% the newline collapses them into one \tiny space, which the DOI runs into
\if@doApice
\newcommand{\apicepubpar}[1]{{\textcolor{rgreddeep}{\tiny\href{https://\ams@apice@host@pub.apice.unibo.it/#1}{\textsf{APICe}}\mbox{~~~}}}}
\newcommand{\apicetalkpar}[1]{{\textcolor{rgreddeep}{\tiny\href{https://\ams@apice@host@talk.apice.unibo.it/#1}{\textsf{APICe}}\mbox{~~~}}}}
%% a thesis has no short host that works yet: its full address
\newcommand{\apicethesispar}[1]{{\textcolor{rgreddeep}{\tiny\href{https://apice.unibo.it/bin/view/Thesis/#1}{\textsf{APICe}}\mbox{~~~}}}}
\else
\newcommand{\apicepubpar}[1]{}
\newcommand{\apicetalkpar}[1]{}
\newcommand{\apicethesispar}[1]{}
\fi
%
\setbeamertemplate{navigation symbols}{}
%
\useoutertheme{infolines}
\useinnertheme[shadow=true]{rounded}
%%% TO UNCOMMENT FOR LOCAL DIR
\usecolortheme{redgrey}
%% background -- plain by default; with bologna or cesena, a seal in grey cropped
%% at the lower-right corner: the Ateneo with the former, the Campus di Cesena
%% with the latter. Cesena's ring is solid where the Ateneo's is an outline, so
%% it is set lighter to weigh the same
\setbeamercolor{background canvas}{bg=rgwhite}
\if@doSeal
  \if@doCesena
    \pgfdeclareimage[height=.97\paperheight]{bg}{almacesena-background}
  \else
    \pgfdeclareimage[height=.97\paperheight]{bg}{almabologna-background}
  \fi
  \setbeamertemplate{background}{\pgfuseimage{bg}}
\fi
%% text
\setbeamercolor{normal text}{fg=rgtext}
\setbeamercolor{alerted text}{fg=rgred}
\setbeamercolor{quote}{fg=rggreymid}
%% bullets
\setbeamercolor*{item}{fg=rgreddark}
%% front page
\setbeamercolor{title}{fg=rgblack}
\setbeamercolor{subtitle}{fg=rggreymid}
\setbeamercolor{author}{fg=rgred}
\setbeamercolor{institute}{fg=rggrey}
\setbeamercolor{date}{fg=rggreymid}
%% head and foot lines -- the wiki's navbar over its breadcrumb band
\setbeamercolor{section in head/foot}{fg=rgwhite,bg=rgred}
\setbeamercolor{subsection in head/foot}{fg=rgtext,bg=rgsilvertint2}
\setbeamercolor{author in head/foot}{fg=rgwhite,bg=rgreddeep}
\setbeamercolor{title in head/foot}{fg=rgtext,bg=rgsilvertint2}
\setbeamercolor{date in head/foot}{fg=rggreymid,bg=rgsilvertint}
%% block headers -- block and alerted dark, example light
\setbeamercolor{block title}{use=structure,fg=rgwhite,bg=rgreddeep}
\setbeamercolor{block title alerted}{use=alerted text,fg=rgwhite,bg=rgred}
\setbeamercolor{block title example}{use=example text,fg=rgtext,bg=rgsilverborder}
%% block bodies
\setbeamercolor{block body}{parent=normal text,use=block title,bg=rgsilvertint}
\setbeamercolor{block body alerted}{parent=normal text,use=block title alerted,bg=rgredfill}
\setbeamercolor{block body example}{parent=normal text,use=block title example,bg=rgsilverfill}
%% table of contents
\setbeamercolor{section in toc}{fg=rgreddeep}
\setbeamercolor{subsection in toc}{fg=rggreymid}
%% footnote
\setbeamercolor{footnote mark}{fg=rgred}
\setbeamercolor{footnote}{fg=rggreymid}
%% biblio
\setbeamertemplate{bibliography item}{\insertbiblabel}
%% the label is a pointer, not a bullet: without this it inherits item's red and
%% collides with the title, which is red on purpose
\setbeamercolor{bibliography item}{fg=rggreymid}
\setbeamercolor{bibliography entry author}{fg=rgtext}
\setbeamercolor{bibliography entry title}{fg=rgred}
\setbeamercolor{bibliography entry location}{fg=rggreymid}
\setbeamercolor{bibliography entry note}{fg=rgreddeep}
%% abstract
\setbeamercolor*{abstract title}{fg=rgreddeep}
\setbeamerfont*{abstract title}{family=\sffamily}
\setbeamercolor*{abstract}{fg=rggreymid}
\setbeamerfont*{abstract}{family=\rmfamily,size=\small}
%% paired commands -- the weights are load-bearing, see README.md
%% citation: both light, for the dark surfaces a marker sits on
%% #1 colour, #2 optional note (-NoValue- when absent), #3 keys.  \cite[]{...}
%% is not \cite{...} -- it typesets an empty note -- so the test is on the
%% marker, not on emptiness.  The marker survives being passed down here.
\newcommand{\ams@cite}[3]{%
  \textcolor{#1}{\textsuperscript{\tiny\IfNoValueTF{#2}{\cite{#3}}{\cite[#2]{#3}}}}%
}
\NewDocumentCommand{\ccite}{o m}{\ams@cite{rggreyline}{#1}{#2}}
\NewDocumentCommand{\cccite}{o m}{\ams@cite{rggreybg}{#1}{#2}}
%% the address of a URL or a DOI is stringed before it is used, so that a special
%% character in it needs no escaping: \_ and a bare _ alike give one underscore.
%% #1 receives #2 as a string with every backslash dropped -- see README.md
\newcommand{\ams@link@arg}{}
\ExplSyntaxOn
\cs_new_protected:Npn \ams_link_string:Nn #1#2
  {
    \tl_set:Nx #1 { \tl_to_str:n {#2} }
    \exp_args:NNo \tl_remove_all:Nn #1 \c_backslash_str
  }
\cs_new_eq:NN \ams@link@string \ams_link_string:Nn
\ExplSyntaxOff
%% URL: plain dark for light surfaces, doubled light for dark ones
\newcommand{\uurl}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{rgred}{\scriptsize\expandafter\url\expandafter{\ams@link@arg}}}}
\newcommand{\uuurl}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{rggreyline}{\tiny\expandafter\url\expandafter{\ams@link@arg}}}}
%% DOI: likewise. https://doi.org is the current resolver; dx.doi.org is a
%% deprecated alias, and the .bst reaches these through \dddoi, so this is the
%% only place the resolver is named
\newcommand{\ddoi}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{rgred}{\scriptsize\href{https://doi.org/\ams@link@arg}{DOI:\ams@link@arg}}}}
\newcommand{\dddoi}[1]{{\ams@link@string\ams@link@arg{#1}%
  \textcolor{rggreyline}{\tiny\href{https://doi.org/\ams@link@arg}{DOI:\ams@link@arg}}}}
%% APICe addresses, printed short and linked: \apice{<kind>}{<Name>} for an
%% object, \apicesite{<alias>} for an alias host, \apicepage{<Space/Page>} for any
%% other page; [<text>] in front prints the text instead. Doubled: light, for dark
%% surfaces. The kinds and their short hosts are this one table -- see README.md
\newcommand{\ams@apice@host@pub}{pubs}
\newcommand{\ams@apice@host@talk}{talks}
\newcommand{\ams@apice@host@course}{courses}
\newcommand{\ams@apice@host@event}{events}
%% theses, journals, projects, products: a line each, once their short hosts
%% resolve page by page
\newcommand{\ams@apice@addr}{}
\newcommand{\ams@apice@obj}[2]{%
  \ifcsname ams@apice@host@#1\endcsname
    \ams@link@string\ams@link@arg{#2}%
    \edef\ams@apice@addr{\csname ams@apice@host@#1\endcsname.apice.unibo.it/\ams@link@arg}%
  \else
    \PackageError{beamerthemeAMSRedGrey}{Unknown APICe kind `#1'}%
      {The kinds are pub, talk, course, event.}%
    \def\ams@apice@addr{apice.unibo.it}%
  \fi}
\newcommand{\ams@apice@show}[1]{\href{https://#1}{\nolinkurl{#1}}}
\newcommand{\ams@apice@text}[2]{\href{https://#1}{#2}}
%% #1 colour, #2 size, #3 the optional text or -NoValue-
\newcommand{\ams@apice@link}[3]{\textcolor{#1}{#2\IfNoValueTF{#3}%
  {\expandafter\ams@apice@show\expandafter{\ams@apice@addr}}%
  {\expandafter\ams@apice@text\expandafter{\ams@apice@addr}{#3}}}}
\NewDocumentCommand{\apice}{o m m}{{\ams@apice@obj{#2}{#3}\ams@apice@link{rgred}{\scriptsize}{#1}}}
\NewDocumentCommand{\aapice}{o m m}{{\ams@apice@obj{#2}{#3}\ams@apice@link{rggreyline}{\tiny}{#1}}}
\NewDocumentCommand{\apicesite}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{\ams@link@arg.apice.unibo.it}%
  \ams@apice@link{rgred}{\scriptsize}{#1}}}
\NewDocumentCommand{\aapicesite}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{\ams@link@arg.apice.unibo.it}%
  \ams@apice@link{rggreyline}{\tiny}{#1}}}
\NewDocumentCommand{\apicepage}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{apice.unibo.it/bin/view/\ams@link@arg}%
  \ams@apice@link{rgred}{\scriptsize}{#1}}}
\NewDocumentCommand{\aapicepage}{o m}{{\ams@link@string\ams@link@arg{#2}%
  \edef\ams@apice@addr{apice.unibo.it/bin/view/\ams@link@arg}%
  \ams@apice@link{rggreyline}{\tiny}{#1}}}
%% emph
\renewcommand{\emph}[1]{\textcolor{rgreddeep}{\textit{#1}}}
%% alert -- light, for dark surfaces
%\renewcommand{\alert}[1]{\textcolor{rgred}{#1}}
\newcommand{\aalert}[1]{\textcolor{rggreyline}{\it#1}}
%% speaker -- both bold: the point is to stand out, and colour alone could not do it.
%% \speaker keeps rgred for the title page; \sspeaker inherits its surface's colour,
%% so it works white-on-green in the footline and dark on a light surface alike
\newcommand{\speaker}[1]{\textcolor{rgred}{\textbf{#1}}}
\newcommand{\sspeaker}[1]{\textbf{#1}}
%
\usepackage[T1]{fontenc}
%% typography: LaTeX's own Computer Modern, as AMSBolognaFC
%% workarounds, so that no document has to carry them -- see README.md
%% commands that cannot survive hyperref's PDF-string expansion.  The two
%% replacements below are \let into place, so that no parameter token ever
%% reaches \pdfstringdefDisableCommands, where it would not survive either.
%% a citation says nothing in a bookmark, and the note has to go with the keys:
%% only an expandable form is expanded away whole -- \NewDocumentCommand is
%% unexpandable, so hyperref would drop the name and leave [note]{keys} behind
\NewExpandableDocumentCommand{\ams@nocite}{o m}{}
%% the DOI is worth keeping in a bookmark, resolver and colour are not
\newcommand{\ams@nodoi}[1]{DOI:#1}
%% an APICe address in a bookmark: the text if one is given, else the address
\NewExpandableDocumentCommand{\ams@noapice}{o m m}{\IfNoValueTF{#1}{\csname ams@apice@host@#2\endcsname.apice.unibo.it/#3}{#1}}
\NewExpandableDocumentCommand{\ams@noapicesite}{o m}{\IfNoValueTF{#1}{#2.apice.unibo.it}{#1}}
\NewExpandableDocumentCommand{\ams@noapicepage}{o m}{\IfNoValueTF{#1}{apice.unibo.it/bin/view/#2}{#1}}
\ifdefined\pdfstringdefDisableCommands
  \pdfstringdefDisableCommands{%
    \let\speaker\@firstofone
    \let\sspeaker\@firstofone
    \let\ccite\ams@nocite
    \let\cccite\ams@nocite
    \let\uurl\@firstofone
    \let\uuurl\@firstofone
    \let\ddoi\ams@nodoi
    \let\dddoi\ams@nodoi
    \let\apicepubpar\@gobble
    \let\apicetalkpar\@gobble
    \let\apicethesispar\@gobble
    \let\apice\ams@noapice
    \let\aapice\ams@noapice
    \let\apicesite\ams@noapicesite
    \let\aapicesite\ams@noapicesite
    \let\apicepage\ams@noapicepage
    \let\aapicepage\ams@noapicepage
    \let\translate\@firstofone
    \let\\\space
  }
\fi
%% Computer Modern Sans has no small-caps shape: the serif one, silently
\DeclareFontShape{T1}{cmss}{m}{sc}{<->ssub*cmr/m/sc}{}
%
\mode
<all>
