%% The AMSRedGrey palette, recovered from AMSCesena: each colour carries its
%% provenance beside it. Roles and contrasts: README.md.

\mode<presentation>

%% base colours
\definecolor{rgred}{HTML}{CC001A}          % darkred in AMSCesena
\definecolor{rgreddark}{HTML}{990000}      % darkestred in AMSCesena, its bullets
\definecolor{rgreddeep}{HTML}{850011}      % darkred!65!black, AMSCesena block title
\definecolor{rgredlight}{HTML}{F0B2BA}     % darkred!30!white, guessed: the light red
\definecolor{rgredtint}{HTML}{FBEBED}      % darkred!8!white, guessed: the faintest red
\definecolor{rgblack}{HTML}{000000}        % black
\definecolor{rgtext}{HTML}{140003}         % darkred!10!black, beaver palette sidebar primary
\definecolor{rgsilver}{HTML}{B3B3B3}       % gray!60!white, beaver frame title right
\definecolor{rgsilvertint}{HTML}{F2F2F2}   % gray!10!white, beaver frame title, AMSCesena block body
\definecolor{rgsilvertint2}{HTML}{D9D9D9}  % gray!30!white, beaver palette primary
\definecolor{rggrey}{HTML}{404040}         % darkgray, guessed: institute
\definecolor{rggreymid}{HTML}{5A5A5A}      % gray!70!black, guessed: secondary text
\definecolor{rggreyline}{HTML}{BFBFBF}     % lightgray, guessed: \ccite, \uuurl
\definecolor{rggreybg}{HTML}{ECECEC}       % gray!15!white, beaver palette secondary, AMSCesena alerted body
\definecolor{rgredfill}{HTML}{F8DEE1}      % derived as amsredfill from amsred (13%)
\definecolor{rgredborder}{HTML}{F0B5BD}    % derived as amsredborder (29%)
\definecolor{rgsilverfill}{HTML}{F1F1F1}   % silver!18!white, derived as amsgreenfill from amsgreen (18%)
\definecolor{rgsilverborder}{HTML}{DCDCDC} % silver!46!white, derived as amsgreenborder (46%)
\definecolor{rgwhite}{HTML}{FFFFFF}
\definecolor{basecolour}{HTML}{CC001A} % red

%% red is the identity colour, deep red and silver the structural one
\setbeamercolor{structure}{fg=rgreddeep}
\setbeamercolor{section in toc}{fg=rgreddeep,bg=rgwhite}
\setbeamercolor{alerted text}{fg=rgred}

%% palettes, light to loud; quaternary carries the identity bar
\setbeamercolor*{palette primary}{fg=rggreymid,bg=rgsilvertint}
\setbeamercolor*{palette secondary}{fg=rgtext,bg=rgsilvertint2}
\setbeamercolor*{palette tertiary}{fg=rgwhite,bg=rgreddeep}
\setbeamercolor*{palette quaternary}{fg=rgwhite,bg=rgred}

\setbeamercolor*{sidebar}{fg=rgreddeep,bg=rgsilvertint}
\setbeamercolor*{palette sidebar primary}{fg=rgtext}
\setbeamercolor*{palette sidebar secondary}{fg=rggreymid}
\setbeamercolor*{palette sidebar tertiary}{fg=rgreddeep}
\setbeamercolor*{palette sidebar quaternary}{fg=rgwhite}

%% title and frame title
\setbeamercolor{titlelike}{parent=palette primary,fg=rgblack}
\setbeamercolor{frametitle}{fg=rgblack,bg=rgsilvertint}
\setbeamercolor{frametitle right}{bg=rgsilvertint2}

%% rules
\setbeamercolor*{separation line}{fg=rgsilver}
\setbeamercolor*{fine separation line}{fg=rggreyline}

\mode
<all>
